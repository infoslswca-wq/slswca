# Public URL (used for canonical URLs, sitemap, CSRF origin check)
NEXT_PUBLIC_SITE_URL=https://slswca.com
# Extra allowed origins for the API, comma-separated (e.g. staging)
ALLOWED_ORIGINS=

# --- Academy form delivery: configure ONE ---
# Option A: email via Resend (https://resend.com)
RESEND_API_KEY=
ACADEMY_INBOX=
MAIL_FROM="SLSWCA Academy <academy@slswca.com>"
# Option B: webhook (Google Apps Script → Sheet, Make, Zapier…)
FORM_WEBHOOK_URL=
FORM_WEBHOOK_SECRET=

# --- Supabase (server only; never expose the service role key to the browser) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# For the future client/mobile auth:
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- PayHere (https://www.payhere.lk) ---
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
# "false" only in production with the live merchant account
PAYHERE_SANDBOX=true
# PayHere must reach the notify URL over the internet. For local testing use a
# tunnel (e.g. cloudflared) and put its https URL here.
PAYHERE_NOTIFY_BASE_URL=

# --- Member accounts (Supabase Auth) ---
# Uses NEXT_PUBLIC_SUPABASE_URL + NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY (or _ANON_KEY) above.
# Set to "true" after enabling the Google provider in Supabase → Auth → Providers.
NEXT_PUBLIC_AUTH_GOOGLE=false

# --- Hardening ---
# Shared rate limiting across serverless instances (https://upstash.com, free tier is fine)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Only set when behind Cloudflare (else leave empty; Vercel's x-real-ip is used)
TRUSTED_IP_HEADER=
# Slack or Discord incoming webhook for server errors (deduped, PII scrubbed)
ERROR_WEBHOOK_URL=
