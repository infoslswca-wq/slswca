# Public URL (used for canonical URLs, sitemap, CSRF origin check)
NEXT_PUBLIC_SITE_URL=https://slswca.com
# Extra allowed origins for the API, comma-separated (e.g. staging)
ALLOWED_ORIGINS=

# --- Academy form delivery: configure ONE ---
# Option A: email via Resend (https://resend.com)
RESEND_API_KEY=
ACADEMY_INBOX=
MAIL_FROM="SLSWCA Academy <academy@slswca.com>"
# Option B: webhook (Google Apps Script → Sheet, Make, Zapier…)
FORM_WEBHOOK_URL=
FORM_WEBHOOK_SECRET=
