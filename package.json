{
  "name": "slswca-platform",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "npm run dev -w @slswca/web",
    "build": "npm run build -w @slswca/web",
    "start": "npm run start -w @slswca/web",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "check": "./scripts/check.sh",
    "check:fast": "./scripts/check.sh --fast",
    "test:db": "./scripts/test-db.sh"
  }
}
